+    await fail_insert(state, "processed_replies")
+    assert await handler._run_native() is False
+    assert handler.provider.confirmed == 0
+    assert (await state.get_prospect(pid)).status == status
+    assert await rows(state, "conversations") == []
+    assert await rows(state, "actions") == []
+    await remove_failure(state)
+    assert await handler._run_native()
+    assert await handler._run_native()
+    assert (await state.get_prospect(pid)).status == "opted_out"
+    assert len(await rows(state, "conversations")) == 1
+    assert len(await rows(state, "actions")) == 1
+    assert await state.get_outbox() == []
+
+
+async def test_prepare_reply_has_no_writes_and_autopilot_is_preserved(state):
+    pid = await contact(state)
+    handler = handler_for(state, approval=False)
+    prospect = await state.get_prospect(pid)
+    convo = Conversation(id="", prospect_id=pid)
+    item = await handler._queue_native_reply(
+        "Merci pour votre intérêt.", prospect, convo,
+        {"subject": "Diagnostic", "message_id": "<incoming@example.net>"}, "interested",
+    )
+    assert item["status"] == "approved" and item["approved_by"] == "autopilot"
+    assert await state.get_outbox() == []
+    assert await rows(state, "conversations") == []
+    assert await rows(state, "actions") == []
+    await state.commit_native_reply(
+        "incoming", convo, "replied", item,
+        {"action_type": "reply_queued", "details": {"prospect_id": pid}},
+    )
+    [saved] = await state.get_outbox()
+    assert saved["approved_by"] == "autopilot"
+    assert saved["conversation_id"] == convo.id
+
+
+@pytest.mark.parametrize("change", ["opted_out", "needs_human"])
+async def test_suppression_that_arrives_during_generation_wins_in_transaction(state, change):
+    pid = await contact(state)
+    convo = Conversation(id="", prospect_id=pid)
+    await state.add_conversation(convo)
+    handler = handler_for(state, approval=False)
+    item = await handler._queue_native_reply(
+        "Merci.", await state.get_prospect(pid), convo, {}, "interested",
+    )
+    if change == "opted_out":
+        await state.update_prospect_status(pid, "opted_out")
+    else:
+        await state.update_conversation(convo.id, status="needs_human")
+    assert await state.commit_native_reply("incoming", convo, "replied", item)
+    assert await state.get_outbox() == []
+    assert len(await state.get_conversations_by_status("needs_human")) == 1
+    if change == "opted_out":
+        assert (await state.get_prospect(pid)).status == "opted_out"
+
+
+async def test_existing_hold_takes_priority_over_an_unrelated_open_thread(state):
+    pid = await contact(state, "replied")
+    await state.add_conversation(Conversation(id="", prospect_id=pid, status="open"))
+    held = Conversation(id="", prospect_id=pid, status="needs_human")
+    await state.add_conversation(held)
+    handler = handler_for(state, brain=NoModel())
+    handler.provider.inbound = [incoming("Oui, merci.")]
+    assert await handler._run_native()
+    assert await state.get_outbox() == []
+    saved = await state.get_conversation(held.id)
+    assert saved.status == "needs_human" and len(saved.thread) == 1
