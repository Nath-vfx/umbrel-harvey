+"""Loop health and graceful pilot drainage, without providers or real mail."""
+
+import asyncio
+import json
+from datetime import datetime, timedelta, timezone
+from types import SimpleNamespace
+
+import pytest
+import pytest_asyncio
+
+import harvey.main as main_mod
+from harvey.config import HarveyConfig
+from harvey.state import StateManager
+
+
+@pytest_asyncio.fixture
+async def loop_harness(monkeypatch, tmp_path):
+    import harvey.agents.analyst as analyst_mod
+    import harvey.agents.handler as handler_mod
+    import harvey.agents.scout as scout_mod
+    import harvey.agents.sender as sender_mod
+    import harvey.agents.writer as writer_mod
+    import harvey.integrations.calendar as calendar_mod
+    import harvey.qualification as qualification_mod
+
+    state = StateManager(str(tmp_path / "health.db"))
+    await state.init_db()
+    cfg = HarveyConfig(
+        persona={"name": "Harvey", "company": "Example", "role": "Assistant",
+                 "email": "assistant@example.com", "linkedin": "", "tone": "plain"},
+        product={"name": "Website", "description": "Local websites", "pricing": "100",
+                 "key_benefits": [], "objection_responses": {}},
+        icp={"industries": [], "company_size": "small", "titles": [], "geography": []},
+        channels={"email": {"provider": "gmail"}},
+        prospecting={"enabled": True},
+    )
+    h = SimpleNamespace(state=state, config=cfg, stop=asyncio.Event(), calls=[],
+                        hooks={}, quiet=False, problem="", budget=True,
+                        paused_reason="", reply_ok=True, calendar_ok=True,
+                        snapshots=[])
+
+    class Brain:
+        provider_label = "Test brain"
+        model = ""
+
+        def __init__(self, *args):
+            pass
+
+        @property
+        def paused_reason(self):
+            return h.paused_reason
+
+        async def preflight(self):
+            return h.problem
+
+        async def is_within_budget(self, *args, **kwargs):
+            return h.budget
+
+    def agent(name):
+        class Agent:
+            is_native = True
+            last_read_problem = "Mailbox read incomplete; authenticate the test account."
+
+            def __init__(self, *args):
+                pass
+
+            async def run(self):
+                h.calls.append(name)
+                if name in h.hooks:
+                    return await h.hooks[name]()
+                return h.reply_ok if name == "replies" else True
+
+        return Agent
+
+    async def calendar_sync(self, state, booking_url):
+        h.calls.append("calendar")
+        await state.set_setting("calendar_sync_status", json.dumps({
+            "status": "ok" if h.calendar_ok else "blocked",
+            "reason": "" if h.calendar_ok else "Calendly read token is missing.",
+        }))
+        return h.calendar_ok
+
+    async def no_qualification(*args, **kwargs):
+        pass
+
+    async def stop_instead_of_sleeping(seconds, event):
+        h.snapshots.append((await state.get_setting("heartbeat_phase"),
+                            await state.get_setting("heartbeat_blocked_reason")))
+        event.set()
+        return True
+
+    monkeypatch.setattr(main_mod, "load_config", lambda: cfg)
+    monkeypatch.setattr(main_mod, "load_env", lambda: SimpleNamespace(calendly_api_token=""))
+    monkeypatch.setattr(main_mod, "StateManager", lambda: state)
+    monkeypatch.setattr(main_mod, "Brain", Brain)
