+"""An incomplete calendar snapshot holds cold mail, without resetting approval."""
+from datetime import datetime
+
+import pytest
+
+from tests.test_pilot_sender_cadence import contact, message, pilot_sender, state  # noqa: F401
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("status", ["", "not-json", "[]", '{"status":"blocked"}', '{"status":"syncing"}'])
+async def test_calendar_failure_holds_then_resumes_same_approved_message(state, monkeypatch, status):
+    sender = pilot_sender(state, monkeypatch, [datetime(2026, 10, 26, 10)])
+    pid = await contact(state, "calendar-hold")
+    mid = await message(state, pid)
+    await state.set_setting("calendar_sync_status", status)
+    await sender._drain_due()
+    assert sender.provider.sent == []
+    assert (await state.get_outbox_item(mid))["status"] == "approved"
+    assert sender.config.channels.email.require_approval is True
+    await state.set_setting("calendar_sync_status", '{"status":"ok"}')
+    await sender._drain_due()
+    row = await state.get_outbox_item(mid)
+    assert row["status"] == "sent" and row["error"] == ""
+    assert sender.config.channels.email.require_approval is True
+
+
+@pytest.mark.asyncio
+async def test_calendar_becoming_incomplete_after_claim_prevents_provider_call(state, monkeypatch):
+    sender = pilot_sender(state, monkeypatch, [datetime(2026, 10, 26, 10)])
+    pid = await contact(state, "calendar-claim")
+    mid = await message(state, pid)
+    original = state.claim_outbox_item
+    async def claim_then_invalidate(item_id):
+        claimed = await original(item_id)
+        await state.set_setting("calendar_sync_status", '{"status":"blocked"}')
+        return claimed
+    monkeypatch.setattr(state, "claim_outbox_item", claim_then_invalidate)
+    await sender._drain_due()
+    assert sender.provider.sent == []
+    assert (await state.get_outbox_item(mid))["status"] == "approved"
+
+
+@pytest.mark.asyncio
+async def test_calendar_failure_does_not_discard_a_reply_owed(state, monkeypatch):
+    sender = pilot_sender(state, monkeypatch, [datetime(2026, 10, 26, 10)])
+    pid = await contact(state, "reply-owed", status="replied")
+    mid = await message(state, pid, kind="reply")
+    await state.set_setting("calendar_sync_status", '{"status":"blocked"}')
+    await sender._drain_due()
+    assert (await state.get_outbox_item(mid))["status"] == "sent"
