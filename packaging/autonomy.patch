+@pytest.mark.asyncio
+async def test_long_pilot_work_finishes_after_stop_without_cycle_cancellation(loop_harness, monkeypatch):
+    h = loop_harness
+    entered, finish = asyncio.Event(), asyncio.Event()
+    cancelled = []
+
+    async def long_work():
+        entered.set()
+        try:
+            await finish.wait()
+        except asyncio.CancelledError:
+            cancelled.append(True)
+            raise
+        h.calls.append("finished")
+        return True
+
+    h.hooks["prospect"] = long_work
+    monkeypatch.setattr(main_mod, "CYCLE_TIMEOUT_SECONDS", 0.001)
+    loop = asyncio.create_task(main_mod.heartbeat(h.stop))
+    try:
+        await asyncio.wait_for(entered.wait(), 5)
+        h.stop.set()
+        await asyncio.sleep(0.02)  # exceeds the old cycle deadline
+        assert not loop.done()
+        assert await h.state.get_setting("heartbeat_phase") == "running"
+        assert await h.state.get_setting("heartbeat_last_cycle_at") == ""
+        assert cancelled == []
+    finally:
+        finish.set()
+        await asyncio.wait_for(loop, 5)
+    assert "finished" in h.calls
+    assert "send" not in h.calls and "calendar" not in h.calls
+    assert await h.state.get_setting("heartbeat_last_cycle_at")
+    assert await h.state.get_setting("heartbeat_phase") == "stopped"
