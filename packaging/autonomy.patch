+def test_disabled_profile_keeps_legacy_parser_behavior(config):
+    config.prospecting.enabled = False
+    writer = Writer(FakeBrain(None), None, config)
+    parsed = writer._parse_sequence({"emails": [
+        {"subject": " hello ", "body": " Hello ", "delay_days": 99},
+        {"subject": "again", "body": "Another angle", "delay_days": "3"},
+    ]})
+    assert [(step.step, step.delay_days) for step in parsed] == [(1, 0), (2, 3)]
+    assert parsed[0].subject == "hello"
