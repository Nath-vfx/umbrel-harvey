+"""Calendar observations stop outreach atomically without inventing email history."""
+
+import asyncio
+import json
+import sqlite3
+
+import pytest
+import pytest_asyncio
+
+from harvey.models.conversation import Conversation, Message
+from harvey.models.prospect import Prospect
+from harvey.state import MIGRATIONS, StateManager
+
+pytestmark = pytest.mark.asyncio
+EMAIL = "contact@atelier.example"
+EVENT = "https://api.calendly.com/scheduled_events/event-1"
+INVITEE = EVENT + "/invitees/invitee-1"
+START = "2026-11-03T09:00:00Z"
+
+
+@pytest_asyncio.fixture
+async def state(tmp_path):
+    manager = StateManager(str(tmp_path / "calendar.db"))
+    await manager.init_db()
+    return manager
+
+
+async def contact(state, *, email=EMAIL, status="contacted"):
+    return await state.add_prospect(Prospect(
+        email=email, first_name="Camille", company="Atelier exemple",
+        status=status, email_status="verified", email_verified=True,
+    ))
+
+
+async def outgoing(state, pid, **values):
+    return await state.add_outbox_item(**{
+        "prospect_id": pid, "to_email": EMAIL, "subject": "Diagnostic",
+        "body": "Un diagnostic de votre site ?", "send_at": "2026-10-28T09:00:00",
+        "provider": "gmail", **values,
+    })
+
+
+async def activities(state):
+    async with state._connect() as db:
+        async with db.execute(
+            "SELECT action_type, agent, details_json FROM actions ORDER BY rowid"
+        ) as cursor:
+            return [(kind, agent, json.loads(details))
+                    for kind, agent, details in await cursor.fetchall()]
+
+
+async def record(state, pid, status="active", **values):
+    return await state.record_calendar_booking(**{
+        "invitee_uri": INVITEE, "event_uri": EVENT, "prospect_id": pid,
+        "start_time": START, "status": status, **values,
+    })
+
+
+async def test_append_migration_keeps_existing_contacts_and_upgrades_once(tmp_path):
+    manager = StateManager(str(tmp_path / "upgrade.db"))
+    async with manager._connect() as db:
+        for script in MIGRATIONS[:-1]:
+            await db.executescript(script)
+        await db.execute(f"PRAGMA user_version = {len(MIGRATIONS) - 1}")
+        await db.execute("INSERT INTO prospects (id, email) VALUES ('retained', ?)", (EMAIL,))
+        await db.commit()
+    await manager.init_db()
+    await manager.init_db()
+    assert (await manager.get_prospect("retained")).email == EMAIL
+    assert await manager.get_calendar_bookings() == []
+    async with manager._connect() as db:
+        async with db.execute("PRAGMA user_version") as cursor:
+            assert (await cursor.fetchone())[0] == len(MIGRATIONS)
+        async with db.execute("PRAGMA index_info(idx_calendar_bookings_prospect)") as cursor:
+            assert [row[2] for row in await cursor.fetchall()] == ["prospect_id"]
+
+
+async def test_active_booking_preserves_thread_and_cancels_only_pending_commercial_mail(state):
+    pid = await contact(state)
+    other = await contact(state, email="other@atelier.example")
+    conversation = Conversation(
+        id="", prospect_id=pid, stage="engaged", intent="interested",
+        thread=[Message(sender="prospect", content="Le diagnostic m'intéresse.")],
+    )
+    cid = await state.add_conversation(conversation)
+    pending = await outgoing(state, pid, status="pending_review", kind="sequence", step=2)
+    reply = await outgoing(state, pid, status="approved", kind="reply", conversation_id=cid)
+    sent = await outgoing(state, pid, status="sent", kind="sequence", step=1)
+    sending = await outgoing(state, pid, status="sending", kind="reply")
+    failed = await outgoing(state, pid, status="failed", kind="reply")
+    await state.update_outbox_item(failed, error="may have gone out: interrupted")
+    unrelated = await outgoing(state, other, to_email="other@atelier.example", status="approved")
+    original_count = len(await state.get_outbox())
+
+    assert await record(state, pid)
+    assert (await state.get_prospect(pid)).status == "meeting"
+    stored = await state.get_conversation(cid)
+    assert stored.status == "meeting_booked" and stored.stage == "closed_won"
+    assert stored.thread == conversation.thread and stored.intent == "interested"
+    for item in (pending, reply):
+        assert (await state.get_outbox_item(item))["status"] == "cancelled"
+    for item, status in ((sent, "sent"), (sending, "sending"), (failed, "failed"),
+                         (unrelated, "approved")):
+        assert (await state.get_outbox_item(item))["status"] == status
+    assert (await state.get_outbox_item(failed))["error"].startswith("may have gone out:")
+    assert len(await state.get_outbox()) == original_count  # no confirmation email
+    [activity] = await activities(state)
+    assert activity == ("meeting_booked", "calendar", {
+        "prospect_id": pid, "invitee_uri": INVITEE, "event_uri": EVENT,
+        "start_time": START, "source": "calendly",
+    })
+    [booking] = await state.get_calendar_bookings(pid)
+    assert booking["event_uri"] == EVENT and booking["start_time"] == START
+    assert await state.get_calendar_bookings(other) == []
+
+
+async def test_replay_and_restart_create_one_legitimate_empty_calendar_conversation(state):
+    pid = await contact(state)
+    results = await asyncio.gather(*(record(state, pid) for _ in range(6)))
+    assert results.count(True) == 1 and results.count(False) == 5
+    [conversation] = await state.get_conversations_by_status("meeting_booked")
+    assert conversation.channel == "calendar" and conversation.thread == []
+    assert conversation.campaign_id == "" and conversation.intent == ""
+    original_booking = await state.get_calendar_bookings(pid)
+    reopened = StateManager(state.db_path)
+    assert not await record(reopened, pid)
+    assert await reopened.get_calendar_bookings(pid) == original_booking
+    assert [c.id for c in await reopened.get_conversations_by_status("meeting_booked")] == [conversation.id]
+    assert len(await activities(state)) == 1
+    assert await state.get_outbox() == []
+
+    # Metadata changes persist without another confirmation or fabricated message.
+    assert await record(state, pid, start_time="2026-11-04T10:00:00+00:00")
+    assert (await state.get_calendar_bookings(pid))[0]["start_time"] == "2026-11-04T10:00:00+00:00"
+    assert len(await activities(state)) == 1
+    assert (await state.get_conversation(conversation.id)).thread == []
+
+
+async def test_active_first_reschedule_never_escalates_the_canceled_old_slot(state):
+    pid = await contact(state)
+    assert await record(state, pid)
+    event2 = "https://api.calendly.com/scheduled_events/event-2"
+    invitee2 = event2 + "/invitees/invitee-2"
+    # Fail if a transient cancellation tries to move the conversation to review.
+    async with state._connect() as db:
+        await db.execute("CREATE TRIGGER no_false_escalation BEFORE UPDATE ON conversations "
+                         "WHEN NEW.status = 'needs_human' "
+                         "BEGIN SELECT RAISE(ABORT, 'reschedule falsely escalated'); END")
+        await db.commit()
+    assert await record(state, pid, event_uri=event2, invitee_uri=invitee2,
+                        start_time="2026-11-05T11:00:00Z")
+    assert await record(state, pid, "canceled")
+    assert not await record(state, pid, "canceled")
+    assert (await state.get_prospect(pid)).status == "meeting"
+    assert len(await state.get_conversations_by_status("meeting_booked")) == 1
+    assert await state.get_conversations_by_status("needs_human") == []
+    assert [a[0] for a in await activities(state)] == ["meeting_booked", "meeting_booked"]
+    assert {b["status"] for b in await state.get_calendar_bookings(pid)} == {"active", "canceled"}
+
+
+async def test_last_cancellation_requires_human_without_restarting_cold_sequence(state):
+    pid = await contact(state)
+    item = await outgoing(state, pid, status="approved")
+    assert await record(state, pid)
+    [conversation] = await state.get_conversations_by_status("meeting_booked")
+    assert await record(state, pid, "canceled")
+    assert (await state.get_prospect(pid)).status == "replied"
+    stored = await state.get_conversation(conversation.id)
+    assert stored.status == "needs_human" and stored.stage == "engaged"
+    assert stored.thread == []
+    assert (await state.get_outbox_item(item))["status"] == "cancelled"
+    assert not await record(state, pid, "canceled")
+    assert [a[0] for a in await activities(state)] == ["meeting_booked", "meeting_cancelled"]
+    assert not await state.queue_prospect_if_unsent(pid)
+    assert len(await state.get_outbox()) == 1
+
+
+async def test_opt_out_and_rights_review_survive_booking_and_cancellation(state):
+    pid = await contact(state, status="opted_out")
+    conversation = Conversation(
+        id="", prospect_id=pid, status="needs_human", stage="closed_lost",
+        thread=[Message(sender="prospect", content="Supprimez mes données.")],
+    )
+    cid = await state.add_conversation(conversation)
+    item = await outgoing(state, pid, status="approved", kind="reply")
+    for status in ("active", "canceled"):
+        assert await record(state, pid, status)
+        assert (await state.get_prospect(pid)).status == "opted_out"
+        stored = await state.get_conversation(cid)
+        assert stored.status == "needs_human" and stored.stage == "closed_lost"
+        assert stored.thread == conversation.thread
+    assert (await state.get_outbox_item(item))["status"] == "cancelled"
+    assert len(await state.get_calendar_bookings(pid)) == 1
+    assert len(await state.get_conversations_by_status("needs_human")) == 1
+
+
+@pytest.mark.parametrize("phase", ["active", "canceled"])
+async def test_database_failure_rolls_back_booking_and_all_effects(state, phase):
+    pid = await contact(state)
+    cid = await state.add_conversation(Conversation(
+        id="", prospect_id=pid, stage="engaged",
+        thread=[Message(sender="prospect", content="Bonjour.")],
+    ))
+    if phase == "canceled":
+        assert await record(state, pid)
+    await outgoing(state, pid, status="approved", kind="reply")
+    before_prospect = await state.get_prospect(pid)
+    before_conversation = await state.get_conversation(cid)
+    before_bookings = await state.get_calendar_bookings()
+    before_outbox = await state.get_outbox()
+    before_actions = await activities(state)
+    async with state._connect() as db:
+        await db.execute("CREATE TRIGGER fail_calendar_activity BEFORE INSERT ON actions "
+                         "BEGIN SELECT RAISE(ABORT, 'injected calendar failure'); END")
+        await db.commit()
+    with pytest.raises(sqlite3.IntegrityError, match="injected calendar failure"):
+        await record(state, pid, phase)
+    assert await state.get_prospect(pid) == before_prospect
+    assert await state.get_conversation(cid) == before_conversation
+    assert await state.get_calendar_bookings() == before_bookings
+    assert await state.get_outbox() == before_outbox
+    assert await activities(state) == before_actions
+    async with state._connect() as db:
+        await db.execute("DROP TRIGGER fail_calendar_activity")
+        await db.commit()
+    assert await record(state, pid, phase)
+    assert not await record(state, pid, phase)
+    assert len(await activities(state)) == len(before_actions) + 1
