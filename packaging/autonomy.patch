+"""Pilot sequences are atomic and their cadence is not selected by the model."""
+from itertools import accumulate
+from pathlib import Path
+
+import pytest
+import pytest_asyncio
+
+from harvey.agents.writer import WRITE_ATTEMPTS_KEY, Writer
+from harvey.config import load_config
+from harvey.models.prospect import Prospect
+from harvey.state import StateManager
+
+
+def sequence():
+    return [
+        {"step": number, "subject": "votre site professionnel",
+         "body": f"Bonjour, constat vérifié {number} pour {{{{company}}}}. Un diagnostic ?",
+         "delay_days": delay}
+        for number, delay in enumerate((0, 4, 6), start=1)
+    ]
+
+
+class FakeBrain:
+    def __init__(self, reply, personal=None):
+        self.reply = reply
+        self.personal = personal
+        self.calls = []
+
+    def load_skills_for_agent(self, name):
+        return ""
+
+    def load_prompt(self, name, **kwargs):
+        return ""
+
+    async def think_json(self, prompt, **kwargs):
+        self.calls.append(kwargs["task"])
+        return self.personal if kwargs["task"] == "personal_email" else self.reply
+
+
+@pytest.fixture
+def config():
+    config = load_config(str(Path(__file__).resolve().parents[1] / "harvey.yaml"))
+    config.prospecting.enabled = True
+    config.writer.humanizer = False
+    config.channels.email.provider = "gmail"
+    return config
+
+
+@pytest_asyncio.fixture
+async def state(tmp_path):
+    state = StateManager(str(tmp_path / "writer.db"))
+    await state.init_db()
+    return state
+
+
+async def eligible_prospect(state):
+    prospect = Prospect(
+        first_name="Camille", last_name="Exemple", title="Gérante",
+        company="Atelier Exemple", industry="photographie",
+        email="contact@atelier.example", email_status="verified",
+        personalization_notes="Le site présente un portfolio de photographie.",
+    )
+    await state.add_prospect(prospect)
+    await state.set_outreach_eligibility(
+        prospect.id, "eligible", "Preuve de test validée",
+        {"email": prospect.email, "company_id": prospect.company_id},
+    )
+    return prospect
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("delays", [(-50, 0, -10), (999, "tomorrow", {}), (None, None, None)])
+async def test_model_delays_cannot_control_sequence_or_persisted_campaign(state, config, delays):
+    prospect = await eligible_prospect(state)
+    payload = sequence()
+    for step, delay in zip(payload, delays):
+        step["delay_days"] = delay
+    brain = FakeBrain(payload, {"subject": "votre portfolio", "body": "Bonjour, votre portfolio présente vos photographies. Un diagnostic ?"})
+    writer = Writer(brain, state, config)
+    writer.skills = ""
+    parsed = await writer._write_sequence([prospect])
+    assert [step.step for step in parsed] == [1, 2, 3]
+    assert [step.delay_days for step in parsed] == [0, 4, 6]
+    assert list(accumulate(step.delay_days for step in parsed)) == [0, 4, 10]
+
+    await writer.run()
+    [campaign] = await state.get_campaigns_by_status("draft")
+    assert [step.delay_days for step in campaign.sequence] == [0, 4, 6]
+    [draft] = await state.get_outbox()
+    assert draft["body"] == brain.personal["body"]
+    assert (await state.get_prospect(prospect.id)).status == "queued"
+
+
+def invalid_sequences():
+    complete = sequence()
+    yield complete[:2]  # no partial campaigns
+    yield complete + [complete[-1]]
+    yield [complete[1], complete[0], complete[2]]
+    yield [complete[0], complete[0], complete[2]]
+    yield {"emails": complete}  # pilot requires the requested array, not repairs
+    for field, value in (
+        ("step", "2"), ("step", True), ("step", 2.0),
+        ("subject", 42), ("body", {"text": "not an email"}),
+        ("subject", "  "), ("body", None),
+    ):
+        payload = sequence()
+        payload[1][field] = value
+        yield payload
+    payload = sequence()
+    del payload[1]["body"]
+    yield payload
+    yield [complete[0], None, complete[2]]
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("payload", list(invalid_sequences()))
+async def test_invalid_sequence_creates_no_campaign_and_can_retry(state, config, payload):
+    prospect = await eligible_prospect(state)
+    brain = FakeBrain(payload)
+    writer = Writer(brain, state, config)
+    await writer.run()
+    assert await state.get_campaigns_by_status("draft") == []
+    assert await state.get_outbox() == []
+    assert (await state.get_prospect(prospect.id)).status == "new"
+
+    brain.reply = sequence()
+    brain.personal = {"subject": "votre portfolio", "body": "Bonjour, votre site présente un portfolio. Un diagnostic ?"}
+    await writer.run()
+    assert len(await state.get_campaigns_by_status("draft")) == 1
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("personal", [None, {}, {"subject": "bonjour", "body": " "},
+                                    {"subject": 123, "body": "Bonjour"},
+                                    {"subject": "bonjour", "body": ["not an email"]}])
+async def test_invalid_personal_draft_never_creates_template_fallback(state, config, personal):
+    prospect = await eligible_prospect(state)
+    brain = FakeBrain(sequence(), personal)
+    await Writer(brain, state, config).run()
+    assert await state.get_campaigns_by_status("draft") == []
+    assert await state.get_outbox() == []
+    assert (await state.get_prospect(prospect.id)).status == "new"
+
