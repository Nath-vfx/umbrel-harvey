+    assert await state.get_contacted_prospects_by_email(EMAIL) == []
+    await outgoing(state, pid, status="sent", kind="reply", provider=provider)
+    await outgoing(state, pid, status="approved", kind="sequence", provider=provider)
+    assert await state.get_contacted_prospects_by_email(EMAIL) == []
+    await outgoing(state, pid, status="sent", kind="sequence", provider="instantly")
+    assert await state.get_contacted_prospects_by_email(EMAIL) == []
+    await outgoing(state, pid, status="sent", kind="sequence", provider=provider)
+    await outgoing(state, pid, status="sent", kind="sequence", provider=provider)
+    assert [p.id for p in await state.get_contacted_prospects_by_email(" CONTACT@ATELIER.EXAMPLE ")] == [pid]
+    for not_exact in ("Camille", "atelier.example", "other@atelier.example", "", " "):
+        assert await state.get_contacted_prospects_by_email(not_exact) == []
+    # Changing the stored address does not turn an old send into contact evidence.
+    await state.update_prospect_email(pid, "new@atelier.example", "verified")
+    assert await state.get_contacted_prospects_by_email("new@atelier.example") == []
+    assert await state.get_contacted_prospects_by_email(EMAIL) == []
