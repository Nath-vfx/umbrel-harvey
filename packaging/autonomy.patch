+@pytest.mark.asyncio
+@pytest.mark.parametrize("failure", [
+    "auth", "quota", "mailbox", "calendar", "agent", "send", "midcycle_quota", "error",
+])
+async def test_blocked_cycles_expose_reason_and_keep_native_reply_gate(loop_harness, monkeypatch, failure):
+    h = loop_harness
+    if failure == "auth":
+        h.problem = "Brain authentication required."
+        expected = "authentication"
+    elif failure == "quota":
+        h.budget = False
+        h.paused_reason = "Quota exhausted until reset."
+        expected = "Quota"
+    elif failure == "mailbox":
+        h.reply_ok = False
+        expected = "Mailbox read incomplete"
+    elif failure == "calendar":
+        h.calendar_ok = False
+        expected = "Calendly read token"
+    elif failure == "agent":
+        async def failed_agent():
+            raise RuntimeError("fictional agent error")
+        h.hooks["prospect"] = failed_agent
+        expected = "Agent prospect failed"
+    elif failure == "send":
+        async def failed_send():
+            raise RuntimeError("fictional send error")
+        h.hooks["send"] = failed_send
+        expected = "Sending failed"
+    elif failure == "midcycle_quota":
+        async def paused_reply_reader():
+            h.paused_reason = "Quota exhausted during reply generation."
+            return False
+        h.hooks["replies"] = paused_reply_reader
+        expected = "Quota exhausted during reply generation"
+    else:
+        async def failed_summary():
+            raise RuntimeError("fictional database error")
+        monkeypatch.setattr(h.state, "get_state_summary", failed_summary)
+        expected = "Heartbeat cycle failed (RuntimeError)"
+    await main_mod.heartbeat(h.stop)
+    assert len(h.snapshots) == 1
+    phase, reason = h.snapshots[0]
+    assert phase == "blocked" and expected in reason
+    assert await h.state.get_setting("heartbeat_blocked_reason") == reason
+    if failure in {"auth", "quota", "mailbox", "midcycle_quota", "error"}:
+        assert "send" not in h.calls
+    if failure == "mailbox":
+        assert expected in (await h.state.current_sends_held())["reason"]
+    if failure == "error":
+        assert await h.state.get_setting("heartbeat_last_cycle_at") == ""
