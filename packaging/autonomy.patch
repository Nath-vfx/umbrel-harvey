+def page(rows, token=None, next_page=None):
+    return {"collection": rows, "pagination": {
+        "count": len(rows), "next_page_token": token, "next_page": next_page,
+    }}
+
+
+def event(key="event-1", status="active", event_type=TYPE):
+    return {"uri": ORIGIN + "/scheduled_events/" + key, "status": status,
+            "event_type": event_type, "start_time": START}
+
+
+def invitee(key="event-1", email=EMAIL, status="active", suffix="invitee-1"):
+    return {"uri": ORIGIN + f"/scheduled_events/{key}/invitees/{suffix}",
+            "event": ORIGIN + "/scheduled_events/" + key,
+            "email": email, "status": status,
+            "questions_and_answers": [{"answer": "PRIVATE QUESTIONNAIRE ANSWER"}],
+            "name": "Private invitee name"}
+
+
+@pytest_asyncio.fixture
+async def state(tmp_path):
+    state = StateManager(str(tmp_path / "calendar.db"))
+    await state.init_db()
+    yield state
+
+
+async def contacted(state, email=EMAIL):
+    pid = await state.add_prospect(Prospect(email=email, first_name="Camille", status="contacted"))
+    oid = await state.add_outbox_item(prospect_id=pid, to_email=email,
+                                      subject="Diagnostic", body="Bonjour", send_at=START,
+                                      provider="gmail", status="sent")
+    await state.update_outbox_item(oid, sent_at=START)
+    return pid
+
+
+async def status(state):
+    return json.loads(await state.get_setting(calendar.STATUS_KEY))
+
+
+async def actions(state):
+    async with state._connect() as db:
+        async with db.execute("SELECT action_type, details_json FROM actions") as cursor:
+            return await cursor.fetchall()
+
+
+class API:
+    def __init__(self):
+        self.calls = []
+        self.types = [dict(uri=TYPE, scheduling_url=BOOKING_URL)]
+        self.active = [event()]
+        self.canceled = []
+        self.invitees = {"event-1": [invitee()]}
+        self.override = None
+
+    def __call__(self, request):
+        self.calls.append(request)
+        assert request.method == "GET"
+        assert request.url.scheme == "https" and request.url.host == "api.calendly.com"
+        assert request.headers["Authorization"] == "Bearer " + TOKEN
+        assert all(value == 15.0 for value in request.extensions["timeout"].values())
+        if self.override:
+            result = self.override(request)
+            if result is not None:
+                return result
+        path = request.url.path
+        if path == "/users/me":
+            payload = {"resource": {"uri": USER}}
+        elif path == "/event_types":
+            assert request.url.params["user"] == USER
+            payload = page(self.types)
+        elif path == "/scheduled_events":
+            assert request.url.params["user"] == USER
+            assert "min_start_time" in request.url.params
+            assert "max_start_time" not in request.url.params
+            payload = page(self.active if request.url.params["status"] == "active" else self.canceled)
+        elif path.endswith("/invitees"):
+            payload = page(self.invitees[path.split("/")[2]])
+        else:
+            raise AssertionError("Unexpected Calendly endpoint")
+        return httpx.Response(200, json=payload)
+
+
+@pytest.fixture
+def api(monkeypatch):
