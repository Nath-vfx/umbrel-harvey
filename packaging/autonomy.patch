+"""Published-only verification stays inside the shared free provider budget."""
+
+import asyncio
+from datetime import timezone
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, Mock
+
+import pytest
+import pytest_asyncio
+
+from harvey.config import ProspectingConfig
+from harvey.integrations import email_finder as ef
+from harvey.state import StateManager
+
+
+@pytest_asyncio.fixture
+async def state(tmp_path):
+    state = StateManager(str(tmp_path / "verification.db"))
+    await state.init_db()
+    return state
+
+
+@pytest.fixture
+def env():
+    return SimpleNamespace(zerobounce_api_key="test-key", reoon_api_key="other-test-key")
+
+
+@pytest.fixture
+def policy():
+    return ProspectingConfig(enabled=True)
+
+
+@pytest.fixture
+def no_fallback(monkeypatch):
+    calls = {}
+    for name in ("verify_reoon", "verify_hunter", "verify_email_smtp", "detect_catch_all",
+                 "_hunter_domain_pattern", "hunter_domain_people", "derive_pattern"):
+        calls[name] = AsyncMock(side_effect=AssertionError(f"Forbidden fallback: {name}"))
+        monkeypatch.setattr(ef, name, calls[name])
+    return calls
+
+
+def budget_key():
+    return f"zerobounce_calls:{ef.datetime.now(timezone.utc):%Y-%m}"
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("mx", [
+    "aspmx.l.google.com", "example-com.mail.protection.outlook.com",
+    "mx.pphosted.com", "mail.example.com",
+])
+@pytest.mark.parametrize("verdict, expected", [
+    ({"status": "valid", "catch_all": False}, "verified"),
+    ({"status": "valid", "catch_all": True}, "risky"),
+    ({"status": "invalid", "catch_all": False}, "invalid"),
+    (None, "guess"),
+])
+async def test_all_mx_use_only_reserved_zerobounce(
+    state, env, policy, monkeypatch, no_fallback, mx, verdict, expected,
+):
+    monkeypatch.setattr(ef, "get_mx_host", AsyncMock(return_value=mx))
+    monkeypatch.setenv("HUNTER_API_KEY", "also-present-but-forbidden")
+
+    async def verify(email, key):
+        assert await state.get_setting(budget_key()) == "1"
+        return verdict
+
+    verifier = AsyncMock(side_effect=verify)
+    monkeypatch.setattr(ef, "verify_zerobounce", verifier)
+    assert await ef.verify_published_address(
+        "office@example.com", env, state=state, policy=policy,
+    ) == expected
+    verifier.assert_awaited_once_with("office@example.com", "test-key")
+    for call in no_fallback.values():
+        call.assert_not_awaited()
+    if verdict is None:
+        assert "unavailable" in await state.get_setting("prospecting_status")
+
+
+@pytest.mark.asyncio
+async def test_named_published_address_used_exactly_without_patterns(
+    state, env, policy, monkeypatch, no_fallback,
+):
+    monkeypatch.setattr(ef, "get_mx_host", AsyncMock(return_value="mail.example.com"))
+    builder = Mock(side_effect=AssertionError("No candidate patterns may be built"))
+    monkeypatch.setattr(ef, "build_email", builder)
+    verifier = AsyncMock(return_value={"status": "valid", "catch_all": False})
+    monkeypatch.setattr(ef, "verify_zerobounce", verifier)
+    result = await ef.find_email(
+        "Jane", "Doe", "example.com", env=env, state=state, policy=policy,
+        known_emails=[("  private-mailbox@example.com  ", "Jane", "Doe")],
+    )
+    assert result.email == "private-mailbox@example.com" and result.verified
+    verifier.assert_awaited_once_with("private-mailbox@example.com", "test-key")
+    builder.assert_not_called()
+    for call in no_fallback.values():
+        call.assert_not_awaited()
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("known", [
+    [],
+    [("john.doe@example.com", "John", "Doe")],
+    [("jane.doe@example.net", "Jane", "Doe")],
+    [("shared@example.com", "Jane", "Doe"), ("shared@example.com", "John", "Doe")],
+])
+async def test_unpublished_or_conflicting_named_address_never_guessed(
+    state, env, policy, monkeypatch, no_fallback, known,
+):
+    builder = Mock(side_effect=AssertionError("No guesses"))
+    monkeypatch.setattr(ef, "build_email", builder)
+    verifier = AsyncMock(side_effect=AssertionError("No unpublished verification"))
+    monkeypatch.setattr(ef, "verify_zerobounce", verifier)
+    result = await ef.find_email(
+        "Jane", "Doe", "example.com", env=env, state=state, policy=policy, known_emails=known,
+    )
+    assert result.email == "" and result.status == "guess"
+    assert await state.get_setting(budget_key()) == ""
+    verifier.assert_not_awaited()
+    builder.assert_not_called()
+    for call in no_fallback.values():
+        call.assert_not_awaited()
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("verdict, expected", [
+    ({"status": "valid", "catch_all": False}, "verified"),
+    ({"status": "valid", "catch_all": True}, "risky"),
+    ({"status": "invalid"}, "invalid"),
+])
+async def test_stored_verdict_survives_reopen_without_spending(
+    state, env, policy, monkeypatch, verdict, expected,
+):
+    monkeypatch.setattr(ef, "get_mx_host", AsyncMock(return_value="mail.example.com"))
+    verifier = AsyncMock(return_value=verdict)
+    monkeypatch.setattr(ef, "verify_zerobounce", verifier)
+    assert await ef.verify_published_address(
+        "office@example.com", env, state=state, policy=policy,
+    ) == expected
+    reopened = StateManager(state.db_path)
+    policy.max_monthly_verifications = 0
+    env.zerobounce_api_key = ""
+    assert await ef.verify_published_address(
+        " OFFICE@EXAMPLE.COM ", env, state=reopened, policy=policy,
+    ) == expected
+    assert await reopened.get_setting(budget_key()) == "1"
+    verifier.assert_awaited_once()
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("failure", [None, RuntimeError("provider failed"), {"status": "unknown"}])
+async def test_failed_calls_are_charged_and_retry_waits_at_quota(
+    state, env, policy, monkeypatch, no_fallback, failure,
+):
+    policy.max_monthly_verifications = 1
+    verifier = AsyncMock(side_effect=failure) if isinstance(failure, Exception) else AsyncMock(return_value=failure)
+    monkeypatch.setattr(ef, "verify_zerobounce", verifier)
+    assert await ef._verify_candidate("office@example.com", "other", env, state=state, policy=policy) == (None, False)
+    assert "waiting" in await state.get_setting("prospecting_status")
+    assert await state.get_setting(budget_key()) == "1"
+    assert await ef._verify_candidate("office@example.com", "other", env, state=state, policy=policy) == (None, False)
+    assert "quota" in await state.get_setting("prospecting_status")
+    verifier.assert_awaited_once()
+    for call in no_fallback.values():
+        call.assert_not_awaited()
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("missing_key, limit, reason", [(True, 100, "key"), (False, 0, "quota")])
+async def test_missing_key_or_zero_quota_visible_without_api_call(
+    state, env, policy, monkeypatch, no_fallback, missing_key, limit, reason,
+):
+    env.zerobounce_api_key = "  " if missing_key else "test-key"
+    policy.max_monthly_verifications = limit
+    verifier = AsyncMock(side_effect=AssertionError("No API call allowed"))
+    monkeypatch.setattr(ef, "verify_zerobounce", verifier)
+    assert await ef._verify_candidate("office@example.com", "google", env, state=state, policy=policy) == (None, False)
+    assert reason in await state.get_setting("prospecting_status")
+    assert int(await state.get_setting(budget_key(), "0")) == 0
+    verifier.assert_not_awaited()
+    for call in no_fallback.values():
+        call.assert_not_awaited()
+
+
+@pytest.mark.asyncio
+async def test_concurrent_verification_shares_atomic_budget_across_state_managers(
+    state, env, policy, monkeypatch, no_fallback,
+):
+    policy.max_monthly_verifications = 3
+    reopened = StateManager(state.db_path)
+    verifier = AsyncMock(return_value={"status": "valid", "catch_all": False})
+    monkeypatch.setattr(ef, "verify_zerobounce", verifier)
+    results = await asyncio.gather(*(
+        ef._verify_candidate(
+            f"contact{index}@example.com", "other", env,
+            state=state if index % 2 else reopened, policy=policy,
+        )
+        for index in range(16)
+    ))
+    assert results.count(("verified", False)) == 3
+    assert results.count((None, False)) == 13
+    assert verifier.await_count == 3
+    assert await reopened.get_setting(budget_key()) == "3"
+    for call in no_fallback.values():
+        call.assert_not_awaited()
