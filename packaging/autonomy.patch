+    await sender._stage_campaign_native(campaign)
+    rows = await state.get_outbox(status="pending_review")
+    follow2 = next(row for row in rows if row["step"] == 2)
+    follow3 = next(row for row in rows if row["step"] == 3)
+    # Thursday 10:00 CEST + four calendar days = Monday 10:00 CET, not 09:00.
+    assert follow2["send_at"] == "2026-10-26T09:00:00"
+    scheduled3 = datetime.fromisoformat(follow3["send_at"])
+    assert scheduled3.date().isoformat() == "2026-11-02"  # J+10 falls Sunday
+    assert_office_hours(scheduled3, "Europe/Paris", sender.config.channels.email.send_window)
+    assert await sender._follow_up_order(follow2, await state.get_prospect(pid)) == "wait"
+    now[0] = datetime(2026, 10, 26, 9)
+    assert await sender._follow_up_order(follow2, await state.get_prospect(pid)) is None
+    assert await sender._follow_up_order(follow3, await state.get_prospect(pid)) == "wait"
+    # Late approval of step 2 never releases step 3 in the same drain.
