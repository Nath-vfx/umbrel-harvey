+pid, lock, ready, terms = map(Path, sys.argv[2:6])
+delay, mode, startup_delay = float(sys.argv[6]), sys.argv[7], float(sys.argv[8])
+finish_at = None
+def stop(signum, frame):
+    global finish_at
+    with terms.open('a') as out:
+        out.write('TERM\n')
+    if finish_at is None:
+        finish_at = time.monotonic() + delay
+signal.signal(signal.SIGTERM, stop)
+if mode == 'exit':
+    sys.exit(3)
+if startup_delay:
+    time.sleep(startup_delay)
+held = None
+try:
+    if mode != 'unconfirmed':
+        held = hold_loop_lock(lock)
+        if held is None:
+            sys.exit(7)
+        write_pid_file(pid)
+    ready.touch()
+    while finish_at is None or time.monotonic() < finish_at:
+        time.sleep(0.01)
