+"""Heartbeat lifecycle with real private child PIDs and the native loop lock.
+
+Children only hold a throwaway lock, publish a PID, and drain on SIGTERM. They
+never invoke Harvey's agents, connect to accounts, or send mail.
+"""
+
+import asyncio
+import json
+import shutil
+import subprocess
+import sys
+from datetime import datetime, timedelta
+from pathlib import Path
+from unittest.mock import AsyncMock
+from zoneinfo import ZoneInfo
+
+import httpx
+import pytest
+
+import harvey.dashboard as dash
+from harvey import config as config_module
+from harvey.pidfile import loop_lock_held
+
+SOURCE_ROOT = Path(dash.__file__).resolve().parent.parent
