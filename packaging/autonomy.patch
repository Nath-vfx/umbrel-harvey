@@ -0,0 +1,324 @@
+"""Pilot cadence uses persisted actual sends, Paris days, and final claim checks.
+
+Only fictional contacts and the in-memory fake mail provider are used.
+"""
+from datetime import datetime, timedelta
+
+import pytest
+import pytest_asyncio
+
+import harvey.agents.sender as sender_mod
+import harvey.state as state_mod
+from harvey.config import HarveyConfig
+from harvey.models.campaign import Campaign, EmailStep
+from harvey.models.prospect import Prospect
+from harvey.state import MAYBE_SENT_PREFIX, StateManager
+from tests.test_outbox_native import FakeProvider, make_sender
+from tests.test_send_window import BASE, assert_office_hours
+
+
+@pytest_asyncio.fixture
+async def state(tmp_path):
+    state = StateManager(str(tmp_path / "cadence.db"))
+    await state.init_db()
+    await state.set_setting("calendar_sync_status", '{"status":"ok","reason":"controlled calendar fixture"}')
+    return state
+
+
+def pilot_sender(state, monkeypatch, now, provider=None):
+    sender = make_sender(state, provider or FakeProvider())
+    sender.config = HarveyConfig(**BASE, channels={"email": {
+        "provider": "smtp", "require_approval": True,
+        "max_daily_sends": 20, "max_daily_new_contacts": 5,
+        "send_window": {"start": "09:00", "end": "17:00",
+                        "weekdays_only": True, "recipient_timezone": False},
+    }}, prospecting={"enabled": True}, usage={"quiet_hours": {
+        "start": "17:00", "end": "09:00", "timezone": "Europe/Paris",
+    }})
+    monkeypatch.setattr(sender_mod, "_utcnow", lambda: now[0])
+    monkeypatch.setattr(state_mod, "_utcnow", lambda: now[0])
+    return sender
+
+
+async def contact(state, name, status="queued"):
+    email = f"{name}@example.com"
+    pid = await state.add_prospect(Prospect(
+        first_name="Alex", last_name="Example", company="Example Workshop",
+        email=email, email_status="verified", email_verified=True, status=status,
+    ))
+    prospect = await state.get_prospect(pid)
+    await state.set_outreach_eligibility(pid, "eligible", "fixture evidence", {
+        "email": email, "company_id": prospect.company_id,
+    })
+    return pid
+
+
+async def message(state, pid, *, kind="sequence", step=1, campaign="pilot",
+                  at="2020-01-01T00:00:00", status="approved", sent_at=None, approved_by="you"):
+    prospect = await state.get_prospect(pid)
+    mid = await state.add_outbox_item(
+        prospect_id=pid, campaign_id=campaign if kind == "sequence" else "",
+        to_email=prospect.email, subject="Votre site professionnel",
+        body="Une question sur votre site professionnel ?", kind=kind, step=step,
+        send_at=at, status=status, approved_by=approved_by,
+    )
+    if sent_at:
+        await state.update_outbox_item(mid, sent_at=sent_at)
+    return mid
+
+
+async def sent_firsts(state, count, at):
+    for index in range(count):
+        pid = await contact(state, f"sent-{index}", status="contacted")
+        await message(state, pid, status="sent", sent_at=at)
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("kind", ["sequence", "reply"])
+@pytest.mark.parametrize("at,allowed", [
+    (datetime(2026, 10, 23, 14, 59), True),   # Friday 16:59 Paris, before DST
+    (datetime(2026, 10, 23, 15), False),       # Friday 17:00
+    (datetime(2026, 10, 24, 10), False),       # Saturday noon
+    (datetime(2026, 10, 26, 7, 59), False),   # Monday 08:59, after DST
+    (datetime(2026, 10, 26, 8), True),         # Monday 09:00
+])
+async def test_every_pilot_outgoing_uses_business_window(state, monkeypatch, kind, at, allowed):
+    now = [at]
+    sender = pilot_sender(state, monkeypatch, now)
+    pid = await contact(state, "window")
+    mid = await message(state, pid, kind=kind)
+    await sender._drain_due()
+    row = await state.get_outbox_item(mid)
+    assert bool(sender.provider.sent) is allowed
+    assert row["status"] == ("sent" if allowed else "approved")
+    if not allowed:
+        scheduled = datetime.fromisoformat(row["send_at"])
+        assert scheduled > at
+        assert_office_hours(scheduled, "Europe/Paris", sender.config.channels.email.send_window)
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("kind", ["sequence", "reply"])
+async def test_window_closing_during_claim_releases_unsent_message(state, monkeypatch, kind):
+    now = [datetime(2026, 10, 23, 14, 59)]
+    sender = pilot_sender(state, monkeypatch, now)
+    pid = await contact(state, "crossing")
+    mid = await message(state, pid, kind=kind)
+    claim = state.claim_outbox_item
+
+    async def crossing_claim(item_id):
+        claimed = await claim(item_id)
+        now[0] = datetime(2026, 10, 23, 15)
+        return claimed
+
+    monkeypatch.setattr(state, "claim_outbox_item", crossing_claim)
+    await sender._drain_due()
+    row = await state.get_outbox_item(mid)
+    assert sender.provider.sent == []
+    assert row["status"] == "approved"
+    later = datetime.fromisoformat(row["send_at"])
+    assert later.date().isoformat() == "2026-10-26"
+    assert_office_hours(later, "Europe/Paris", sender.config.channels.email.send_window)
+
+
+@pytest.mark.asyncio
+async def test_pause_landing_after_claim_prevents_provider_call(state, monkeypatch):
+    now = [datetime(2026, 10, 26, 10)]
