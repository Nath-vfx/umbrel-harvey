+from tests.test_send_window import BASE
+
+pytestmark = pytest.mark.asyncio
+EMAIL = "contact@atelier.example"
+
+
+class RecordingProvider(FakeProvider):
+    def __init__(self):
+        super().__init__()
+        self.confirmed = 0
+
+    def confirm_read(self):
+        self.confirmed += 1
+
+
+class NoModel(StubBrain):
+    async def think(self, *args, **kwargs):
+        raise AssertionError("deterministic route must not call the model")
+
+
+def handler_for(state, *, brain=None, pilot=True, approval=True):
+    config = HarveyConfig(**BASE)
+    config.channels.email.provider = "smtp"
+    config.channels.email.require_approval = approval
+    config.prospecting.enabled = pilot
+    config.writer.humanizer = False
+    handler = Handler(brain or StubBrain(), state, config, EnvConfig())
+    handler.provider = RecordingProvider()
+    return handler
+
+
+async def contact(state, status="contacted"):
+    return await state.add_prospect(Prospect(
+        email=EMAIL, first_name="Camille", company="Atelier exemple",
+        email_status="verified", email_verified=True, status=status,
+    ))
+
+
+def incoming(body="Bonjour, pouvez-vous expliquer le diagnostic ?", key="incoming-1"):
+    return InboundMessage(provider_id=key, message_id=f"<{key}@example.net>",
+                          from_email=EMAIL, subject="Diagnostic", body=body,
+                          thread_ref="provider-thread")
+
+
+async def rows(state, table):
+    assert table in {"actions", "conversations", "processed_replies"}
+    async with state._connect() as db:
+        async with db.execute(f"SELECT * FROM {table}") as cursor:
+            return await cursor.fetchall()
+
+
+async def fail_insert(state, table):
+    assert table in {"outbox", "actions", "processed_replies"}
+    async with state._connect() as db:
+        await db.execute(f"CREATE TRIGGER fail_final_write BEFORE INSERT ON {table} "
+                         "BEGIN SELECT RAISE(ABORT, 'injected transaction failure'); END")
+        await db.commit()
+
+
+async def remove_failure(state):
+    async with state._connect() as db:
+        await db.execute("DROP TRIGGER fail_final_write")
+        await db.commit()
+
+
+@pytest.mark.parametrize("body", [
+    "Non merci.", "STOP", "Désabonnez-moi", "Ne me contactez plus.",
+    "STOP\nCordialement,\nCamille",
+    "Ne m’écrivez plus.", "Supprimez mes données.",
+])
+async def test_french_refusal_is_permanent_without_acknowledgment(state, body):
+    pid = await contact(state)
+    handler = handler_for(state, brain=NoModel())
+    handler.provider.inbound = [incoming(body)]
+    assert await handler._run_native()
+    assert (await state.get_prospect(pid)).status == "opted_out"
+    assert await state.get_outbox() == []
+    assert len(await rows(state, "actions")) == 1
+    assert await state.is_reply_processed("incoming-1")
+    assert handler.provider.confirmed == 1
+    if "données" in body:
+        assert [c.prospect_id for c in await state.get_conversations_by_status("needs_human")] == [pid]
+    await state.add_prospect(Prospect(email=EMAIL, first_name="Camille", status="new"))
+    await state.update_prospect_status(pid, "contacted")
+    assert (await state.get_prospect(pid)).status == "opted_out"
+    assert await handler._run_native()
+    assert len(await rows(state, "conversations")) == 1
+    assert len(await rows(state, "actions")) == 1
