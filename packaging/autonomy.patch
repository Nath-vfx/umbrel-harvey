@@ -0,0 +1,154 @@
+"""Final outgoing pilot policy; fictional contacts, no external providers."""
+from datetime import datetime
+from types import SimpleNamespace
+
+import pytest
+import pytest_asyncio
+
+from harvey.gate import MAX_BODY_WORDS, autopilot_review, pre_send_check
+from harvey.state import StateManager
+from tests.test_pilot_sender_cadence import contact, message, pilot_sender
+
+
+BOOKING = "https://calendly.com/example-owner/30min"
+INFO = (
+    "Example Agency vous contacte au sujet de votre site professionnel, sur la base "
+    "de son intérêt légitime à proposer ses services aux professionnels. Votre adresse "
+    "a été publiée sur votre site professionnel. Vous pouvez demander l’origine précise, "
+    "l’accès, la rectification ou la suppression de vos données en répondant à ce message."
+)
+
+
+def config(enabled=True, booking=BOOKING, domains=()):
+    return SimpleNamespace(
+        prospecting=SimpleNamespace(enabled=enabled),
+        persona=SimpleNamespace(email="assistant@example.org"),
+        channels=SimpleNamespace(email=SimpleNamespace(link_domains=list(domains))),
+        product=SimpleNamespace(offer=SimpleNamespace(booking_url=booking)),
+    )
+
+
+@pytest.mark.parametrize("body", [
+    "Le site coûte 2 875 €.",
+    "Notre tarif de référence est de 2875 euros.",
+    "Je vous accorde une remise.",
+    "Voici un devis sur mesure.",
+    "Voici notre offre personnalisée.",
+    "Nous pouvons signer le contrat demain.",
+    "Nous garantissons les résultats.",
+    "Nous vous promettons davantage de clients.",
+    "Votre site sera prêt vendredi.",
+    "Nous livrons sous sept jours.",
+    "Nous allons doubler vos ventes.",
+    "Vous obtiendrez dix nouveaux clients.",
+    "Our price is $3000.",
+    "A discount of ten percent is available.",
+    "Here is your custom quote.",
+    "The contract is attached.",
+    "We guarantee results.",
+    "We will deliver within two weeks.",
+    "Your website will be ready tomorrow.",
+    "You'll double your revenue.",
+    "Une ré\u200bmise de １０ ％.",
+    "ＧＡＲＡＮＴＩＥ de résultats.",
+])
+def test_commercial_terms_are_held_in_subject_or_final_body(body):
+    for subject, outgoing in [("Votre site", body), (body, "Bonjour.")]:
+        reasons = autopilot_review(subject, outgoing, config())
+        assert any("commercial" in reason and "human review" in reason for reason in reasons)
+
+
+@pytest.mark.parametrize("body", [
+    "Le diagnostic est gratuit et sans engagement.",
+    "The diagnostic is free and without obligation.",
+    "Votre site présente-t-il bien votre activité ?",
+    "Qui met à jour vos horaires sur le site ?",
+    "Would a diagnostic of your website be useful?",
+    "Souhaitez-vous en discuter pendant 30 minutes ?",
+    INFO + "\nPour ne plus être contacté, répondez STOP.",
+])
+def test_free_diagnostic_factual_questions_and_rights_footer_pass(body):
+    assert autopilot_review("Votre site", body, config()) == []
+
+
+@pytest.mark.parametrize("url", [
+    "https://calendly.com/example-owner",
+    BOOKING + "/another-event",
+    BOOKING + "/",
+    BOOKING + "?utm_source=mail",
+    BOOKING + "#booking",
+    BOOKING.replace("https:", "http:"),
+    BOOKING.replace("https://", ""),
+    BOOKING.replace("example-owner", "other-owner"),
+    BOOKING.replace("calendly.com", "www.calendly.com"),
+    BOOKING.replace("calendly.com", "calendly.com:443"),
+    BOOKING.replace("calendly.com", "calendly.com@example.net"),
+    BOOKING.replace("30min", "%33%30min"),
+    BOOKING + "/../other-event",
+])
+def test_booking_requires_exact_url_even_when_domain_is_allowlisted(url):
+    reasons = autopilot_review("Bonjour", f"Réservez ici : {url}",
+                               config(domains=["calendly.com"]))
+    assert reasons
+    assert any("booking" in reason or "links to" in reason for reason in reasons)
+
+
+@pytest.mark.parametrize("booking", [BOOKING, BOOKING + "?event=diagnostic#form"])
+def test_exact_configured_booking_url_passes(booking):
+    assert autopilot_review("Bonjour", f"Réservez ici : {booking}", config(booking=booking)) == []
+
+
+def test_disabled_profiles_retain_legacy_commercial_and_booking_rules():
+    body = f"A $100 discount guaranteed. Book at {BOOKING}/extra?tracking=yes"
+    assert autopilot_review("Offer", body, config(enabled=False)) == []
+
+
+def test_pilot_does_not_exempt_own_or_foreign_domains_from_existing_review():
+    assert autopilot_review("Bonjour", "Notre site : https://example.org", config()) == []
+    assert any("links to" in reason for reason in
+               autopilot_review("Bonjour", "Voir https://foreign.example", config()))
+
+
+def test_b2b_footer_still_counts_towards_global_body_limit():
+    body = "Bonjour " * (MAX_BODY_WORDS - 2) + INFO + "\nRépondez STOP."
+    result = pre_send_check("alex@example.com", "Votre site", body, kind="reply")
+    assert any("body too long" in reason for reason in result.reasons)
+
+
+@pytest_asyncio.fixture
+async def state(tmp_path):
+    state = StateManager(str(tmp_path / "commercial.db"))
+    await state.init_db()
+    await state.set_setting("calendar_sync_status", '{"status":"ok","reason":"controlled calendar fixture"}')
+    return state
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("kind,step", [("sequence", 1), ("sequence", 2), ("reply", 1)])
+@pytest.mark.parametrize("rewrite_after_claim", [False, True])
+async def test_sender_holds_all_outgoing_kinds_and_rechecks_rewritten_body(
+        state, monkeypatch, kind, step, rewrite_after_claim):
+    now = [datetime(2026, 10, 26, 10)]
+    sender = pilot_sender(state, monkeypatch, now)
+    sender.config.channels.email.require_approval = False
+    pid = await contact(state, "commercial", status="contacted" if step == 2 else "queued")
+    if step == 2:
+        await message(state, pid, status="sent", sent_at="2026-10-22T08:00:00")
+    mid = await message(state, pid, kind=kind, step=step, approved_by="autopilot")
+    unauthorized = "Nous garantissons les résultats."
+    await state.update_outbox_item(
+        mid, body="Bonjour, une question sur votre site ?" if rewrite_after_claim else unauthorized)
+    if rewrite_after_claim:
+        original_claim = state.claim_outbox_item
+
+        async def rewrite(item_id):
+            claimed = await original_claim(item_id)
+            await state.update_outbox_item(item_id, body=unauthorized)
+            return claimed
+
+        monkeypatch.setattr(state, "claim_outbox_item", rewrite)
+    await sender._drain_due()
+    assert sender.provider.sent == []
+    held = await state.get_outbox_item(mid)
+    assert held["status"] == "pending_review"
+    assert "commercial terms or promises require human review" in held["error"]
