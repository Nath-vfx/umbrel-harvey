+@pytest.mark.parametrize("table", ["outbox", "actions", "processed_replies"])
+async def test_failure_rolls_back_entire_final_decision_and_retry_is_single(state, table):
+    pid = await contact(state)
+    await state.set_setting(REVIEW_NEXT_REPLY_KEY + pid, "true")
+    old = Conversation(id="", prospect_id=pid, stage="engaged",
+                       thread=[Message(sender="harvey", content="Notre proposition.")])
+    old.id = await state.add_conversation(old)
+    handler = handler_for(state, approval=False)
+    handler.provider.inbound = [incoming()]
+    await fail_insert(state, table)
+    assert await handler._run_native() is False
+    assert handler.provider.confirmed == 0
+    assert not await state.is_reply_processed("incoming-1")
+    assert (await state.get_prospect(pid)).status == "contacted"
+    [convo] = await state.get_conversations_by_status("open")
+    assert convo.thread == old.thread and convo.stage == "engaged"
+    assert await state.get_outbox() == []
+    assert await rows(state, "actions") == []
+    assert await state.get_setting(REVIEW_NEXT_REPLY_KEY + pid) == "true"
+    await remove_failure(state)
+    assert await handler._run_native()
+    assert await handler._run_native()
+    assert len(await rows(state, "conversations")) == 1
+    [convo] = await state.get_conversations_by_status("open")
+    assert len(convo.thread) == 2
+    [item] = await state.get_outbox(kind="reply")
+    assert item["status"] == "pending_review"
+    assert item["in_reply_to"] == "<incoming-1@example.net>"
+    assert item["thread_ref"] == "provider-thread"
+    assert len(await rows(state, "actions")) == 1
+    assert not await state.get_setting(REVIEW_NEXT_REPLY_KEY + pid)
