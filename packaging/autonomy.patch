+"""Consumer-visible outreach proof and shared-budget invariants."""
+import asyncio
+from types import SimpleNamespace
+
+import httpx
+import pytest
+
+from harvey.config import ProspectingConfig, EmailChannelConfig, ComplianceConfig
+from harvey.models.company import Company
+from harvey.models.prospect import Prospect
+from harvey.qualification import qualify_outreach, qualify_pending_outreach
+from harvey.state import StateManager
+
+
+@pytest.fixture
+def config():
+    return SimpleNamespace(prospecting=ProspectingConfig(enabled=True, postcode_prefixes=["65"]),
+                           icp=SimpleNamespace(geography=["Tarbes"]))
+
+
+@pytest.mark.asyncio
+async def test_shared_budget_survives_concurrency_and_reopening(tmp_path):
+    state = StateManager(str(tmp_path / "budget.db"))
+    await state.init_db()
+    claims = await asyncio.gather(*(state.reserve_budget("discovery_queries:2026-10-23", 5)
+                                    for _ in range(20)))
+    assert sum(claims) == 5
+    reopened = StateManager(state.db_path)
+    assert not await reopened.reserve_budget("discovery_queries:2026-10-23", 5)
+    assert await reopened.reserve_budget("discovery_queries:2026-10-24", 5)
+    assert not await state.reserve_budget("zero", 0)
+
+
+@pytest.mark.parametrize("field", ["max_daily_queries", "results_per_query", "refill_below", "max_monthly_verifications"])
+def test_negative_budgets_rejected(field):
+    with pytest.raises(ValueError):
+        ProspectingConfig(**{field: -1})
+
+
+def test_paid_selection_and_negative_contact_cap_rejected():
+    with pytest.raises(ValueError):
+        ProspectingConfig(provider="serper")
+    with pytest.raises(ValueError):
+        ProspectingConfig(verification_provider="hunter")
+    with pytest.raises(ValueError):
+        EmailChannelConfig(max_daily_new_contacts=-1)
+    assert ComplianceConfig(opt_out_line="Pour ne plus être contacté, répondez STOP.").opt_out_line
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("postcode,size,email_status,spoof,expected", [
+    ("65000", "Entreprise individuelle de photographie", "verified", False, "eligible"),
+    ("75000", "Entreprise individuelle de photographie", "verified", False, "rejected"),
+    ("inconnu", "Entreprise individuelle de photographie", "verified", False, "needs_human"),
+    ("65000", "Notre équipe de photographie", "verified", False, "needs_human"),
+    ("65000", "Entreprise individuelle de photographie", "guess", False, "needs_human"),
+    ("65000", "Entreprise individuelle de photographie", "verified", True, "needs_human"),
+    ("65000", "Réseau national avec 100 salariés", "verified", False, "rejected"),
+])
+async def test_site_evidence_not_search_or_model_score(tmp_path, monkeypatch, config,
+                                                       postcode, size, email_status, spoof, expected):
+    state = StateManager(str(tmp_path / "proof.db"))
+    await state.init_db()
+    company = Company(domain="studio.example", website="https://studio.example", name="Studio Exemple")
+    await state.add_company(company)
+    prospect = Prospect(company_id=company.id, email="contact@studio.example", email_status=email_status,
+                        company="Studio Exemple", score=100)
+    await state.add_prospect(prospect)
+    html = f"<p>{size}</p><p>Implantation : {postcode} Tarbes</p><p>contact@studio.example</p>"
+    monkeypatch.setattr("harvey.qualification.public_http_client", lambda **kw: httpx.AsyncClient(
+        transport=httpx.MockTransport(lambda request: httpx.Response(
+            200, text=html, headers={"content-type": "text/html"}, request=request)), follow_redirects=True))
+    evidence = {"source_url": company.website, "email_quote": "contact@studio.example",
+                "locality_quote": "Implantation : " + postcode + " Tarbes", "size_quote": size,
+                "need_quote": size if not spoof else "Un faux constat absent du site"}
+    ok, reason = await qualify_outreach(state, prospect, company, config, evidence)
+    row = await state.get_outreach_eligibility(prospect.id)
+    assert row["status"] == expected
+    assert ok == (expected == "eligible")
+    assert reason == row["reason"]
+    assert row["evidence"]["email"] == prospect.email
+    assert await state.count_writable_prospects(eligible_only=True) == int(expected == "eligible")
+
+
+@pytest.mark.asyncio
+async def test_backfill_uses_same_proof_and_rejects_foreign_redirect(tmp_path, monkeypatch, config):
+    state = StateManager(str(tmp_path / "proof.db"))
+    await state.init_db()
+    company = Company(domain="studio.example", website="https://studio.example")
+    await state.add_company(company)
+    prospect = Prospect(company_id=company.id, email="contact@studio.example", email_status="verified")
+    await state.add_prospect(prospect)
+    def serve(request):
+        if request.url.host == "studio.example":
+            return httpx.Response(302, headers={"location": "https://other.example"}, request=request)
+        return httpx.Response(200, text="Entreprise individuelle de photographie 65000 contact@studio.example",
+                              headers={"content-type": "text/html"}, request=request)
+    monkeypatch.setattr("harvey.qualification.public_http_client", lambda **kw: httpx.AsyncClient(
+        transport=httpx.MockTransport(serve), follow_redirects=True))
+    assert await qualify_pending_outreach(state, config) == 0
+    assert (await state.get_outreach_eligibility(prospect.id))["status"] == "needs_human"
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("locality,source,expected", [
+    ("Chiffre d’affaires à Tarbes : 65000 euros", "https://studio.example", "needs_human"),
+    ("Zone d’intervention : 65000 Tarbes", "https://studio.example", "needs_human"),
+    ("Adresse : 65000 Tarbes", "https://studio.example", "eligible"),
+    ("12 rue Exemple, 65000 Tarbes", "https://studio.example/contact", "eligible"),
+    ("12 rue Exemple, 65000 Tarbes", "https://studio.example/realisations", "needs_human"),
+])
+async def test_establishment_not_amount_or_service_area(tmp_path, monkeypatch, config, locality, source, expected):
+    state = StateManager(str(tmp_path / "locality.db"))
+    await state.init_db()
+    company = Company(domain="studio.example", website="https://studio.example")
+    await state.add_company(company)
+    prospect = Prospect(company_id=company.id, email="contact@studio.example", email_status="verified")
+    await state.add_prospect(prospect)
+    size = "Photographe indépendante"
+    html = f"<p>{size}</p><p>{locality}</p><p>contact@studio.example</p>"
+    monkeypatch.setattr("harvey.qualification.public_http_client", lambda **kw: httpx.AsyncClient(
+        transport=httpx.MockTransport(lambda request: httpx.Response(
+            200, text=html, headers={"content-type": "text/html"}, request=request))))
+    await qualify_outreach(state, prospect, company, config, {
+        "source_url": source, "email_quote": prospect.email, "size_quote": size,
+        "need_quote": size, "locality_quote": locality,
+    })
+    assert (await state.get_outreach_eligibility(prospect.id))["status"] == expected
