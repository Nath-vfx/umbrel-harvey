+    # Model a non-normalized legacy/import row despite normalized insertion APIs.
+    async with state._connect() as db:
+        await db.execute("INSERT INTO prospects (id, email, first_name) VALUES (?, ?, ?)",
+                         ("legacy-duplicate", EMAIL.upper(), "Camille"))
